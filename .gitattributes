# Line endings each platform expects, in checkouts and in GitHub's "Download ZIP".
*.sh text eol=lf
*.command text eol=lf
bin/* text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.reg binary

# For agents and the maintainer, not for the people the ZIP goes to.
HANDOFF.md export-ignore

# Tests for whoever changes the installers.
tests/ export-ignore

# For agents and the maintainer (claude-harness), not for the people the ZIP goes to.
AGENTS.md export-ignore
CLAUDE.md export-ignore
.claude/ export-ignore
.githooks/ export-ignore
.github/ export-ignore
docs/handoffs/ export-ignore
