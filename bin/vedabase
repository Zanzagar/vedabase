#!/usr/bin/env bash
# vedabase: open the Bhaktivedanta VedaBase (Folio Views 4.3 under Wine).
set -euo pipefail

VB_REPO=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$VB_REPO/lib/common.sh"
# shellcheck source=../lib/display.sh
source "$VB_REPO/lib/display.sh"
vb_init_paths

usage() {
  cat <<EOF
Usage: vedabase [COMMAND] [INFOBASE]

  open [INFOBASE]   open it in a window on this desktop (needs \$DISPLAY:
                    a Linux desktop, WSLg, or ssh -X)
  web  [INFOBASE]   headless machines: run it in a private display and serve
                    that to your browser through an SSH tunnel
  stop              close VedaBase and stop the browser viewer
  status            show what is running
  doctor            check the installation
  backup [FILE]     save the prefix (program, infobases, your notes) as .tar.gz
  where             print where everything lives
  unicode [-]       turn text copied out of VedaBase into Unicode, on the
                    clipboard (the browser viewer's, when it runs and there is
                    no desktop); with -, standard input to standard output

INFOBASE is vedabase (default), vanibase, help (Folio's own help infobase),
or folio (Folio Views with no infobase; use File > Open). Without a COMMAND,
'vedabase' or 'vedabase vanibase' opens a window if there is a display and
the browser viewer otherwise. 'vedabase help' shows this text; Folio's own
help opens with 'vedabase open help'.

The browser viewer listens on port 6080, or on the one VEDABASE_WEB_PORT
names when it starts (VEDABASE_WEB_PORT=6081 vedabase web). It keeps that
port until 'vedabase stop', and 'web' and 'status' give the link to it.
EOF
}

infobase_arg() {
  case ${1:-vedabase} in
    vedabase) printf '%s\n' "$VB_APP_WIN\\Nfo\\Bhaktivedanta Vedabase 2003.sdw" ;;
    vanibase) printf '%s\n' "$VB_APP_WIN\\Nfo\\VaniBase_25.sdw" ;;
    help) printf '%s\n' "$VB_APP_WIN\\Nfo\\Foliohlp.nfo" ;;
    folio) printf '\n' ;;
    *) vb_die "unknown infobase '$1' (use vedabase, vanibase, help or folio)" ;;
  esac
}

require_install() {
  vb_installed || vb_die "VedaBase is not installed in $VB_PREFIX; run install.sh first"
}

# Start Views.exe detached. DESKTOP (WxH) puts it in a Wine virtual desktop,
# which supplies window frames where no window manager runs.
launch() { # INFOBASE [DESKTOP]
  local arg cmd=(wine)
  arg=$(infobase_arg "$1")
  [[ $1 == vanibase && ! -f $VB_APP_DIR/Nfo/VaniBase_25.sdw ]] &&
    vb_die "VaniBase is not installed (install.sh was run with --no-vanibase)"
  [[ -n ${2:-} ]] && cmd+=(explorer "/desktop=VedaBase,$2")
  cmd+=("$VB_APP_WIN\\Views.exe")
  [[ -n $arg ]] && cmd+=("$arg")
  mkdir -p "$VB_LOGS"
  (cd "$VB_APP_DIR" && setsid "${cmd[@]}" >>"$VB_LOGS/views.log" 2>&1 </dev/null &)
}

# One prefix shows on one display at a time: a second Wine process would join
# the running session wherever that is.
web_running() { vb_display_alive web && vb_websockify_alive; }

cmd_open() {
  require_install
  [[ -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} ]] ||
    vb_die "no display here; use 'vedabase web', or connect with ssh -X"
  vb_env
  ! web_running || vb_die "VedaBase is running in the browser viewer; use that, or 'vedabase stop' first"
  launch "${1:-vedabase}"
}

web_url() { # PORT
  printf 'http://localhost:%s/vnc.html?autoconnect=1&resize=scale&reconnect=1&password=%s\n' \
    "$1" "$(<"$VB_RUN/web/password")"
}

# How to reach the viewer: the link, and outside WSL the SSH tunnel it needs,
# both to the port the running viewer listens on. VEDABASE_WEB_PORT picks the
# port of a viewer that starts; one that runs keeps its own, since moving it
# would cut off the browsers on it, so another port asked for now only gets
# told how to move it.
web_instructions() {
  local host port
  port=$(vb_websockify_port) ||
    vb_die "the browser viewer's page server has stopped; run 'vedabase stop', then 'vedabase web'"
  if [[ -n ${VEDABASE_WEB_PORT:-} && $VEDABASE_WEB_PORT != "$port" ]]; then
    printf 'The browser viewer is on port %s, and stays there while it runs. To move it\nto port %s, run:  vedabase stop; VEDABASE_WEB_PORT=%s vedabase web\n\n' \
      "$port" "$VEDABASE_WEB_PORT" "$VEDABASE_WEB_PORT"
  fi
  if [[ -n ${WSL_DISTRO_NAME:-} ]]; then
    # WSL forwards localhost to Windows, so no tunnel is needed.
    printf 'Open this in your Windows browser:\n  %s\n' "$(web_url "$port")"
  else
    host=$(hostname -f 2>/dev/null || hostname)
    cat <<EOF
1. On your own computer, open a tunnel (leave it running):
     ssh -N -L $port:127.0.0.1:$port $VB_USER@$host
   (Or add a local forward $port -> 127.0.0.1:$port to your SSH client's saved session.)
2. Open in a browser:
     $(web_url "$port")
EOF
  fi
  printf '\nCopy text out through the clipboard tab on the noVNC side panel.\nStop it with: vedabase stop\n'
}

cmd_web() {
  require_install
  local geom=${VEDABASE_WEB_GEOMETRY:-1600x1000} t
  [[ -x /usr/bin/xkbcomp && -d /usr/share/X11/xkb ]] ||
    vb_die "the browser viewer needs x11-xkb-utils and xkb-data (sudo apt-get install x11-xkb-utils xkb-data); on a desktop use 'vedabase open'"
  vb_env
  for t in Xtigervnc tigervncpasswd xauth xdotool; do
    command -v "$t" >/dev/null || vb_die "the browser viewer's parts are missing ($t); run install.sh again"
  done
  if web_running; then
    if [[ -n $(vb_prefix_pids) ]]; then
      # Already showing: give the way in again rather than start a second
      # Folio, and a nudger again if the one it had is gone.
      vb_display_use web
      vb_nudger_ensure
      printf 'VedaBase is already running in the browser viewer (to open another infobase\nthere, use File > Open in it).\n\n'
      web_instructions
      return 0
    fi
  elif [[ -n $(vb_prefix_pids) ]]; then
    ! vb_display_alive web ||
      vb_die "the browser viewer's page is no longer served; run 'vedabase stop', then 'vedabase web'"
    vb_die "VedaBase is already open on a desktop; close it, or run 'vedabase stop', first"
  fi
  vb_web_start "$geom"
  # Fill the virtual desktop: Folio restores its window to AppPosition
  # (left,top,right,bottom) and does not maximize under Wine by itself.
  wine reg add 'HKCU\Software\VedaBase\4\Views\Frame\Layout' /v AppPosition \
    /d "0,0,${geom/x/,}" /f >/dev/null 2>&1 || true
  launch "${1:-vedabase}" "$geom"
  printf '\nVedaBase is running in a private display.\n\n'
  web_instructions
}

cmd_stop() {
  vb_env
  vb_wine_stop
  vb_web_stop
  vb_say "Stopped"
}

cmd_status() {
  local pids port
  pids=$(vb_prefix_pids | paste -sd' ')
  printf 'install:  %s\n' "$(vb_installed && echo "$VB_APP_DIR" || echo 'not installed')"
  if [[ -n $pids ]]; then
    printf 'wine:     running (pids %s)\n' "$pids"
  else
    printf 'wine:     not running\n'
  fi
  if vb_display_alive web && port=$(vb_websockify_port); then
    printf 'web:      %s\n' "$(web_url "$port")"
  else
    printf 'web:      off\n'
  fi
}

cmd_doctor() {
  local ok=1 f
  check() { # DESCRIPTION COMMAND...
    if "${@:2}" >/dev/null 2>&1; then printf '  ok    %s\n' "$1"; else printf '  FAIL  %s\n' "$1"; ok=0; fi
  }
  vb_env
  echo "VEDABASE_HOME=$VB_HOME"
  check "Wine runs ($VB_WINE_NAME)" wine --version
  check "prefix exists" test -f "$VB_PREFIX/system.reg"
  check "Folio Views installed" test -f "$VB_APP_DIR/Views.exe"
  check "VedaBase 25 infobase" test -f "$VB_APP_DIR/Nfo/VedaBase_25.nfo"
  check "VedaBase shadow file" test -f "$VB_APP_DIR/Nfo/Bhaktivedanta Vedabase 2003.sdw"
  if [[ -f $VB_APP_DIR/Nfo/VaniBase_25.nfo ]]; then
    printf '  ok    VaniBase 25 infobase\n'
  else
    printf '  info  VaniBase 25 not installed (optional)\n'
  fi
  f=$(find "$VB_PREFIX/drive_c/windows/Fonts" -maxdepth 1 -iname 'balaram_.ttf' 2>/dev/null) || f=''
  check "diacritic fonts in C:\\windows\\Fonts" test -n "$f"
  if command -v vedabase >/dev/null 2>&1; then
    printf '  ok    vedabase command on PATH\n'
  else
    printf '  info  the vedabase command works after you log out and back in; meanwhile run %s\n' "$VB_BIN_LINK"
  fi
  if [[ -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} ]]; then
    echo "  info  display ${DISPLAY:-$WAYLAND_DISPLAY}: 'vedabase open' will show a window here"
  else
    echo "  info  no display: use 'vedabase web' (or ssh -X)"
  fi
  ((ok)) || return 1
}

cmd_backup() {
  require_install
  local out=${1:-$VB_HOME/backups/vedabase-prefix-$(date +%Y%m%d).tar.gz}
  vb_env
  [[ -z $(vb_prefix_pids) ]] || vb_die "VedaBase is running; close it (vedabase stop) first"
  vb_say "Saving $VB_PREFIX to $out"
  # Your notes and licensed files: yours only. Written aside, then renamed, so
  # an older file of the same name (whose mode tar would keep) is replaced.
  (umask 077 && mkdir -p -- "$(dirname -- "$out")" && rm -f -- "$out.part" &&
    tar -C "$VB_HOME" -czf "$out.part" prefix) || { rm -f -- "$out.part"; vb_die "could not write $out"; }
  mv -f -- "$out.part" "$out"
  vb_say "Restore elsewhere with: install.sh --restore $out"
}

# The converter is bin/vedabase-unicode, which the Mac app runs too. It finds
# xclip among the tools install.sh unpacked. Without a desktop, the clipboard
# is the browser viewer's: noVNC's clipboard panel shows what it holds.
cmd_unicode() {
  vb_env
  if [[ ${1:-} != - && -z ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && web_running; then
    vb_display_use web
  fi
  exec "$VB_REPO/bin/vedabase-unicode" "$@"
}

cmd_where() {
  cat <<EOF
home      $VB_HOME
prefix    $VB_PREFIX
program   $VB_APP_DIR
downloads $VB_DOWNLOADS
logs      $VB_LOGS
EOF
}

# 'open', 'web' and 'stop' change what runs for this installation, one at a
# time: two at once could each take what the other had just started for
# leftovers. install.sh holds the same lock while it installs or repairs.
# flock(1) holds the lock while the command runs and lets it go when the
# command ends; -o keeps it out of what the command leaves running (Xvnc,
# websockify, Wine), which outlives it.
with_lock() { # ARGS...: this script again, with ARGS, under the lock
  local rc=0
  if [[ -n ${VB_LOCKED:-} ]]; then
    unset VB_LOCKED
    return 0
  fi
  [[ -d $VB_HOME ]] || return 0
  command -v flock >/dev/null ||
    vb_die "the flock command is missing; install it once with:  sudo apt-get install util-linux"
  mkdir -p "$VB_RUN"
  chmod 700 "$VB_RUN"
  VB_LOCKED=1 flock -o -w 60 -E 75 "$VB_RUN/lock" "$0" "$@" || rc=$?
  ((rc != 75)) || vb_die "another 'vedabase' command, or install.sh, is still busy with this installation; try again once it has finished"
  exit "$rc"
}

main() {
  local sub=${1:-}
  case $sub in
    open | web | stop | vedabase | vanibase | folio | '') with_lock "$@" ;;
  esac
  case $sub in
    -h | --help | help) usage ;;
    open | web | stop | status | doctor | backup | where | unicode)
      shift
      "cmd_$sub" "$@" ;;
    vedabase | vanibase | folio) # "vedabase vanibase" reads naturally too
      shift
      if [[ -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} ]]; then cmd_open "$sub"; else cmd_web "$sub"; fi ;;
    '')
      if [[ -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} ]]; then cmd_open; else cmd_web; fi ;;
    *)
      usage >&2
      exit 2 ;;
  esac
}

main "$@"
