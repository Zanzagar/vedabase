#!/bin/bash
# vedabase-unicode: turn text copied out of VedaBase into Unicode.
#   vedabase-unicode      converts the text on the clipboard
#   vedabase-unicode -    converts standard input to standard output
# Exit status: 0 converted; 3 nothing to convert; 4 not converted, because the
# text already holds Unicode letters the conversion makes (ā, ṣ, ...) or is the
# text it converted last: once converted, ñ means ñ, and converting again
# would turn it into ṣ. 1: no clipboard to use.
# Linux runs it as 'vedabase unicode'; the Mac's "VedaBase Unicode" app runs it
# as it is. Written for the bash 3.2 and BSD tools that macOS ships.
set -euo pipefail

VB_UNICODE_MAP=${VB_UNICODE_MAP:-$(cd "$(dirname "$0")/.." && pwd)/lib/balaram-unicode.tsv}
work=$(mktemp -d "${TMPDIR:-/tmp}/vedabase-unicode.XXXXXX")
locked=0
trap 'rm -rf -- "$work"; if ((locked)); then drop_lock; fi' EXIT
# Without these, Ctrl-C or a closed terminal ends the script without the EXIT trap.
trap 'exit 130' INT
trap 'exit 129' HUP
trap 'exit 143' TERM

# The table's rows, comments left out, as "legacy<TAB>unicode".
rows() { grep -v '^#' "$VB_UNICODE_MAP" | grep . || true; }

# One s///g per row. The table maps ï to ñ and ñ to ṣ, so the rows whose
# letter another row produces (ñ, Ñ) run first: an ñ made from ï is then never
# converted again, and the rows act as one simultaneous mapping.
make_sed() {
  local legacy unicode
  rows | cut -f2 >"$work/values"
  rows | while IFS='	' read -r legacy unicode; do
    if grep -qxF -- "$legacy" "$work/values"; then printf 's/%s/%s/g\n' "$legacy" "$unicode"; fi
  done
  rows | while IFS='	' read -r legacy unicode; do
    if ! grep -qxF -- "$legacy" "$work/values"; then printf 's/%s/%s/g\n' "$legacy" "$unicode"; fi
  done
}

# The Unicode letters the table makes that are not legacy letters too (all
# but ñ and Ñ): text holding one of them is not fresh from VedaBase.
make_refuse() {
  rows | cut -f1 >"$work/keys"
  rows | cut -f2 | grep -vxF -f "$work/keys" || true
}

# convert IN OUT: OUT gets the converted text (or IN as it was, unless it is
# converted). Returns 0, 3 or 4, as the exit status above, or 1 if a step
# failed. Every step is checked by hand: called as 'convert ... || status=$?',
# a function runs without set -e, and a failed sed would pass for success.
convert() {
  local rc=0 last='' size
  LC_ALL=C grep -qF -f "$work/refuse" -- "$1" || rc=$?
  case $rc in
    0) cp -- "$1" "$2" || return 1; return 4 ;;
    1) ;;
    *) return 1 ;;
  esac
  # A sed may end its output with a newline the input lacked, so give the
  # input one and take it off again afterwards.
  cp -- "$1" "$work/sed-in" || return 1
  if [[ -s $1 ]]; then last=$(tail -c 1 -- "$1" | od -An -tx1 | tr -d ' \n') || return 1; fi
  if [[ -n $last && $last != 0a ]]; then printf '\n' >>"$work/sed-in" || return 1; fi
  LC_ALL=C sed -f "$work/map.sed" "$work/sed-in" >"$work/sed-out" || return 1
  if [[ -n $last && $last != 0a ]]; then
    size=$(wc -c <"$work/sed-out" | tr -d ' ') || return 1
    head -c "$((size - 1))" "$work/sed-out" >"$2" || return 1
  else
    cp -- "$work/sed-out" "$2" || return 1
  fi
  rc=0
  cmp -s -- "$1" "$2" || rc=$?
  case $rc in
    0) return 3 ;;
    1) return 0 ;;
    *) return 1 ;;
  esac
}

message() { # STATUS [HINT]
  case $1 in
    0) echo "Converted to Unicode. Paste it where you like." ;;
    1) echo "Something went wrong while converting, so nothing was changed." ;;
    3) echo "Nothing to convert: the text has none of VedaBase's old diacritics.${2:+ $2}" ;;
    4) echo "Not converted: the text already has Unicode diacritics (such as ā or ṣ), so it is not fresh from VedaBase.${2:+ $2}" ;;
  esac
}

# --- the clipboard --------------------------------------------------------------
# Folio runs under Wine as an X program, also on Wayland desktops, so xclip
# (which the installer fetches) comes first wherever there is an X display.
pick_clipboard() {
  if [[ $(uname -s) == Darwin ]]; then
    clip=pb
  elif [[ -n ${DISPLAY:-} ]] && command -v xclip >/dev/null; then
    clip=xclip
  elif [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wl-paste >/dev/null && command -v wl-copy >/dev/null; then
    clip=wl
  elif [[ -z ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
    note "No desktop here, so no clipboard to convert. Convert a file instead: vedabase unicode - <in.txt >out.txt" 0
    exit 1
  else
    note "The clipboard tool xclip is missing: run install.sh again, or: sudo apt-get install xclip" 0
    exit 1
  fi
}

# Outside a terminal (the menu entry, the Mac app) the note is all there is to
# see, so it goes to the desktop too: a dialog that closes itself on the Mac,
# a notification on Linux when a session bus is there to show it.
note() { # MESSAGE SECONDS (0: until closed)
  printf '%s\n' "$1" >&2
  if [[ ${clip:-} == pb ]]; then
    osascript -e 'on run argv' -e 'activate' \
      -e 'display dialog (item 1 of argv) with title "VedaBase Unicode" buttons {"OK"} default button 1 giving up after ((item 2 of argv) as integer)' \
      -e 'end run' "$1" "${2:-0}" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null &&
    { [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] || [[ -S ${XDG_RUNTIME_DIR:-/nonexistent}/bus ]]; }; then
    notify-send -a VedaBase -t "$((${2:-0} * 1000))" 'VedaBase Unicode' "$1" >/dev/null 2>&1 || true
  fi
}

# xclip and wl-copy stay in the background to hand the text over, so they
# must not hold this script's output open. A program holding the clipboard
# that does not answer would leave a read hanging: timeout (Linux) ends it.
clip_get() {
  case $clip in
    pb) LANG=en_US.UTF-8 pbpaste ;;
    xclip) with_timeout xclip -selection clipboard -t UTF8_STRING -o 2>/dev/null ;;
    wl) with_timeout wl-paste --no-newline 2>/dev/null ;;
  esac
}
with_timeout() { if command -v timeout >/dev/null; then timeout 10 "$@"; else "$@"; fi; }
clip_put() {
  case $clip in
    pb) LANG=en_US.UTF-8 pbcopy ;;
    xclip) xclip -selection clipboard -t UTF8_STRING -i >/dev/null 2>&1 ;;
    wl) wl-copy >/dev/null 2>&1 ;;
  esac
}

# The text converted last is remembered (as a checksum, not the text): a
# second press would otherwise turn the ñ of yajña into ṣ. It is written
# before the clipboard changes, and a lock beside it lets one press at a time
# read, convert and publish, so a second press sees either the old text or
# the new one with its checksum.
if [[ $(uname -s) == Darwin ]]; then
  last=$HOME/Library/Caches/VedaBase/unicode-last
else
  last=${XDG_CACHE_HOME:-$HOME/.cache}/vedabase/unicode-last
fi
lock=$last.lock

# mkdir is atomic, so one press at a time holds the lock, with its process ID
# inside. A lock whose owner is gone (a press that was killed; one with no ID
# after a minute) is taken over, under a second lock so that two waiters
# cannot both do it. One whose owner still runs never is: after 5 s the press
# gives up, busy. Returns 2 if the folder cannot be written, 3 if busy.
take_lock() {
  local i owner
  mkdir -p -- "$(dirname -- "$last")" 2>/dev/null || return 2
  for ((i = 0; i < 50; i++)); do
    if mkdir -- "$lock" 2>/dev/null; then
      locked=1
      echo "$$" >"$lock/pid" || return 2
      return 0
    fi
    owner=$(cat -- "$lock/pid" 2>/dev/null) || owner=''
    if { [[ -n $owner ]] && ! kill -0 "$owner" 2>/dev/null; } ||
      { [[ -z $owner ]] && [[ -n $(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null) ]]; }; then
      if mkdir -- "$lock.reclaim" 2>/dev/null; then
        if [[ $(cat -- "$lock/pid" 2>/dev/null) == "$owner" ]]; then rm -rf -- "$lock"; fi
        rmdir -- "$lock.reclaim" 2>/dev/null || :
        continue
      fi
    fi
    sleep 0.1
  done
  return 3
}
# Only ever this press's own lock.
drop_lock() {
  if ((locked)) && [[ $(cat -- "$lock/pid" 2>/dev/null) == "$$" ]]; then rm -rf -- "$lock"; fi
  locked=0
}

# Leaves the clipboard as it was, says why, and ends with STATUS.
give_up() { # STATUS MESSAGE SECONDS
  drop_lock
  note "$2" "$3"
  exit "$1"
}

convert_clipboard() {
  local status=0 rc=0 text='' remembered='' current
  pick_clipboard
  take_lock || case $? in
    3) give_up 1 "Another conversion is still running. Try again in a moment." 6 ;;
    *) give_up 1 "Could not use $(dirname -- "$last") to remember the converted text, so nothing was changed." 0 ;;
  esac
  # A read that fails with nothing read is an empty clipboard; one that fails
  # part way, or does not answer, must not pass for the whole text.
  clip_get >"$work/raw" || rc=$?
  if ((rc == 124)); then give_up 1 "The clipboard did not answer, so nothing was changed. Try again." 0; fi
  if ((rc)) && [[ -s $work/raw ]]; then give_up 1 "Could not read the whole clipboard, so nothing was changed." 0; fi
  # Windows programs read text up to its first NUL. Folio's copy, as Wine
  # hands it over, goes on past one with whatever followed in Folio's buffer.
  IFS= read -r -d '' text <"$work/raw" || :
  printf '%s' "$text" >"$work/in" || give_up 1 "$(message 1)" 0
  # No checksum yet is fine; one that cannot be read is not.
  if [[ -e $last ]]; then
    remembered=$(cat -- "$last") || give_up 1 "Could not read what it converted last ($last), so nothing was changed." 0
  fi
  if [[ -s $work/in && -n $remembered ]]; then
    current=$(cksum <"$work/in") || give_up 1 "$(message 1)" 0
    if [[ $current == "$remembered" ]]; then
      give_up 4 "Not converted: this is the text it has just converted. Copy some text in VedaBase, then convert." 6
    fi
  fi
  convert "$work/in" "$work/out" || status=$?
  case $status in
    0) ;;
    1) give_up 1 "$(message 1)" 0 ;;
    *) give_up "$status" "$(message "$status" 'Copy some text in VedaBase, then convert.')" 6 ;;
  esac
  { cksum <"$work/out" >"$last.new" && mv -f -- "$last.new" "$last"; } 2>/dev/null ||
    give_up 1 "Could not remember the converted text in $(dirname -- "$last"), so nothing was changed." 0
  clip_put <"$work/out" || give_up 1 "Could not put the converted text on the clipboard." 0
  drop_lock
  note "$(message 0)" 2
}

make_sed >"$work/map.sed"
make_refuse >"$work/refuse"
case ${1:-} in
  '')
    convert_clipboard ;;
  -)
    cat >"$work/in"
    status=0
    convert "$work/in" "$work/out" || status=$?
    [[ $status == 1 ]] || cat -- "$work/out"
    [[ $status == 0 ]] || message "$status" >&2
    exit "$status" ;;
  *)
    echo "usage: vedabase-unicode      converts the text on the clipboard" >&2
    echo "       vedabase-unicode -    converts standard input to standard output" >&2
    exit 2 ;;
esac
